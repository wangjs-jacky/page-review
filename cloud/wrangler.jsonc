{
  "name": "page-review-cloud",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "page-review-cloud", "database_id": "replace-with-d1-id", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "page-review-cloud-files" }],
  "observability": { "enabled": false }
}
