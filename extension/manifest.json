{
  "manifest_version": 3,
  "name": "Page Review · 网页评注",
  "version": "0.4.13",
  "description": "标下网页上值得关注的地方，保存评注和画面，跨网页整理给 AI。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "tabCapture",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "启用网页评注",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self'; base-uri 'none'; media-src 'self' data: blob:"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "启用网页评注或确认本页录制"
    }
  },
  "version_name": "0.4.13 评注点击稳定性修复",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png",
        "panel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://ba-login.paws.rodeo/*"
    ]
  }
}
