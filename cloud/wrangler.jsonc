{
  "name": "page-review-cloud",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "page-review-cloud",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "page-review-cloud-files"
    },
    {
      "binding": "RELEASES",
      "bucket_name": "page-review-cli-releases"
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "review.paws.rodeo",
      "zone_name": "paws.rodeo",
      "custom_domain": true
    }
  ],
  "vars": {
    "API_ORIGIN": "https://review.paws.rodeo",
    "LOGIN_ORIGIN": "https://ba-login.paws.rodeo"
  }
}
